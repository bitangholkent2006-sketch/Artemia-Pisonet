# ==============================================================================
# Artemia's Pisonet Management System - Environment Configuration Template
# ==============================================================================
# CRITICAL NOTICE: Keep all real database connection strings and JWT secrets 
# out of git repositories. Set them directly in your hosting provider's 
# environment dashboard (e.g. Render Dashboard or local .env file).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Service Configuration (apps/backend)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# MongoDB Atlas Connection
# Format: mongodb+srv://<db_user>:<db_password>@<cluster-subdomain>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@<CLUSTER_SUBDOMAIN>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=artemias_pisonet

# Authentication Secrets
# Generate a cryptographically strong 32+ character secret (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_secure_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# Session Leases and Network Outage Boundaries
SESSION_LEASE_DURATION_SECONDS=90
DISCONNECT_GRACE_PERIOD_SECONDS=60

# Allowed CORS Origins (Comma-separated in production)
# Example: https://artemia-pisonet-admin.onrender.com,http://localhost:4200
ADMIN_ORIGIN=http://localhost:4200,https://artemia-pisonet-admin.onrender.com
ELECTRON_ORIGIN=*

# Initial Bootstrap Administrator (Used by `npm run seed:admin`)
ADMIN_INIT_USERNAME=artemia_admin
ADMIN_INIT_PASSWORD=replace_with_secure_initial_admin_password
ADMIN_INIT_FULLNAME=Artemia Administrator

# ------------------------------------------------------------------------------
# 2. Frontend & Desktop Client Configuration (apps/admin & apps/customer-desktop)
# ------------------------------------------------------------------------------
VITE_SHOP_NAME="Artemia's Cyber Lounge & Pisonet"
VITE_SHOP_BRANCH_ID="BRANCH-01"

# Public API & Real-time Socket URL
# Development: http://localhost:3000
# Production:  https://artemia-pisonet-backend.onrender.com
VITE_API_BASE_URL=http://localhost:3000
VITE_WS_SERVER_URL=http://localhost:3000

# Station Hardware Identification (Configured per physical customer PC)
STATION_IDENTIFIER=STATION-01-VIP
STATION_DEVICE_KEY=station_hardware_auth_key_generated_at_registration

# Target Client Operating System & Electron Security Policy
TARGET_PLATFORM=win32
ELECTRON_CONTEXT_ISOLATION=true
ELECTRON_NODE_INTEGRATION=false
ELECTRON_SANDBOX=true
